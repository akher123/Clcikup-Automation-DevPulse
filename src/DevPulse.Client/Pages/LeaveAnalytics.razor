@page "/leave-analytics"
@attribute [Authorize(Policy = "CanViewReports")]
@using DevPulse.Client.Analytics
@using DevPulse.Shared.Contracts.Leave
@implements IAsyncDisposable
@inject ILeaveApiClient LeaveApi
@inject IJSRuntime JS

<PageTitle>@AppBranding.PageTitle("Leave Analytics")</PageTitle>

<div class="leave-analytics-page">
    <div class="analytics-hero leave-analytics-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Insights · Team Leave</p>
            <h1>Leave Analytics</h1>
            <p class="analytics-lead">
                Monitor how leave is consumed, what is awaiting approval, and how much balance remains across the team.
                Approved days count as consumed; pending requests reduce available balance until reviewed.
            </p>
        </div>
        <div class="analytics-hero-actions">
            <a class="btn btn-outline-light btn-sm" href="leave">Leave Applications</a>
            <a class="btn btn-outline-light btn-sm" href="holidays">Holiday Calendar</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="analytics-toolbar filter-card card mb-4">
        <div class="card-body">
            <div class="filter-section-header mb-3">
                <span class="filter-section-label">Filters</span>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-auto">
                    <label class="form-label">Year</label>
                    <div class="holiday-toolbar leave-analytics-year-toolbar">
                        <button type="button" class="holiday-year-btn" @onclick="PreviousYearAsync" aria-label="Previous year">‹</button>
                        <span class="holiday-year-label">@_selectedYear</span>
                        <button type="button" class="holiday-year-btn" @onclick="NextYearAsync" aria-label="Next year">›</button>
                        <button type="button"
                                class="period-chip @(_selectedYear == DateTime.Today.Year ? "active" : null)"
                                @onclick="GoToCurrentYearAsync">
                            This year
                        </button>
                    </div>
                </div>
                @if (_leaveTypes.Count > 0)
                {
                    <div class="col-lg">
                        <label class="form-label">Leave type</label>
                        <div class="period-chips">
                            <button type="button"
                                    class="period-chip @(_selectedLeaveTypeId is null ? "active" : null)"
                                    @onclick="() => SelectLeaveTypeAsync(null)">
                                All types
                            </button>
                            @foreach (var leaveType in _leaveTypes)
                            {
                                <button type="button"
                                        class="period-chip @(_selectedLeaveTypeId == leaveType.Id ? "active" : null)"
                                        @onclick="() => SelectLeaveTypeAsync(leaveType.Id)">
                                    @leaveType.Name
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <LoadingIndicator Text="Loading leave analytics..." />
    }
    else if (_summary is null)
    {
        <div class="empty-state analytics-idle">
            <div class="empty-state-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5ZM2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2Z"/></svg>
            </div>
            <h5>No leave data available</h5>
            <p class="text-muted mb-0">
                Configure leave types and link active developers to accounts to start tracking team leave utilization.
            </p>
        </div>
    }
    else
    {
        var developers = LeaveChartData.AggregateByDeveloper(_summary, _selectedLeaveTypeId);
        var leaveTypes = GetFilteredLeaveTypes();
        var pendingDevelopers = developers
            .Where(d => d.PendingDays > 0)
            .OrderByDescending(d => d.PendingDays)
            .Take(8)
            .ToList();
        var attentionDevelopers = LeaveChartData.GetAttentionDevelopers(developers);
        var filteredUsed = GetFilteredUsed();
        var filteredPending = GetFilteredPending();
        var filteredRemaining = GetFilteredRemaining();
        var filteredAllocated = LeaveChartData.TotalAllocated(developers);
        var teamUtilization = LeaveChartData.TeamUtilizationPercent(filteredUsed, filteredPending, filteredAllocated);
        var consumedShare = filteredAllocated > 0 ? (double)(filteredUsed / filteredAllocated * 100m) : 0;
        var pendingShare = filteredAllocated > 0 ? (double)(filteredPending / filteredAllocated * 100m) : 0;

        <div class="analytics-results-enter">
            <div class="analytics-period-label mb-3">
                <span>Showing</span>
                <strong>@_selectedYear</strong>
                <span class="text-muted">· @GetFilterLabel() · @_summary.ActiveDevelopers active developer(s)</span>
            </div>

            <div class="leave-analytics-legend mb-4" aria-label="Chart legend">
                <span class="leave-analytics-legend-item">
                    <span class="leave-analytics-legend-swatch leave-analytics-legend-consumed"></span>
                    Consumed — approved leave taken
                </span>
                <span class="leave-analytics-legend-item">
                    <span class="leave-analytics-legend-swatch leave-analytics-legend-pending"></span>
                    Pending — awaiting approval
                </span>
                <span class="leave-analytics-legend-item">
                    <span class="leave-analytics-legend-swatch leave-analytics-legend-remaining"></span>
                    Remaining — available balance
                </span>
            </div>

            <div class="kpi-grid leave-analytics-kpi-grid mb-4">
                <KpiScorecard Label="Team Utilization"
                              Value="@LeaveChartData.FormatPercent(teamUtilization)"
                              Hint="@($"{LeaveChartData.FormatDays(filteredUsed + filteredPending)} of {LeaveChartData.FormatDays(filteredAllocated)} days committed")"
                              Progress="teamUtilization"
                              Tone="@(teamUtilization >= 90 ? "danger" : teamUtilization >= 70 ? "warning" : "accent")"
                              Meta="Used + pending" />
                <KpiScorecard Label="Consumed"
                              Value="@LeaveChartData.FormatDays(filteredUsed)"
                              Hint="@($"{LeaveChartData.FormatPercent(consumedShare)} of allocated leave")"
                              Tone="success"
                              Meta="Approved" />
                <KpiScorecard Label="Pending"
                              Value="@LeaveChartData.FormatDays(filteredPending)"
                              Hint="@($"{LeaveChartData.CountWithPending(developers)} developer(s) awaiting review")"
                              Tone="@(filteredPending > 0 ? "warning" : "neutral")"
                              Meta="In queue" />
                <KpiScorecard Label="Remaining"
                              Value="@LeaveChartData.FormatDays(filteredRemaining)"
                              Hint="Balance still available this year"
                              Tone="primary"
                              Meta="Available" />
                <KpiScorecard Label="Allocated"
                              Value="@LeaveChartData.FormatDays(filteredAllocated)"
                              Hint="Total leave entitlement for the filter"
                              Tone="neutral"
                              Meta="@_selectedYear.ToString()" />
                <KpiScorecard Label="At Risk"
                              Value="@LeaveChartData.CountHighUtilization(developers).ToString()"
                              Hint="Developers at or above 90% utilization"
                              Tone="@(LeaveChartData.CountHighUtilization(developers) > 0 ? "danger" : "neutral")"
                              Meta="≥ 90%" />
            </div>

            @if (attentionDevelopers.Count > 0)
            {
                <div class="data-card card at-risk-panel leave-attention-panel mb-4">
                    <div class="card-body p-0">
                        <h5 class="card-title card-title-bar">Needs Attention · @attentionDevelopers.Count developer@(attentionDevelopers.Count == 1 ? "" : "s")</h5>
                        <div class="at-risk-grid leave-attention-grid">
                            @foreach (var entry in attentionDevelopers)
                            {
                                var utilization = LeaveChartData.UtilizationPercent(entry.UsedDays, entry.PendingDays, entry.DaysPerYear);
                                <div class="at-risk-card leave-attention-card">
                                    <div class="at-risk-card-name">@entry.DeveloperName</div>
                                    <div class="leave-attention-metrics">
                                        @if (entry.PendingDays > 0)
                                        {
                                            <span class="leave-attention-tag leave-attention-tag-pending">
                                                @LeaveChartData.FormatDays(entry.PendingDays) day(s) pending
                                            </span>
                                        }
                                        @if (utilization >= 90)
                                        {
                                            <span class="leave-attention-tag leave-attention-tag-critical">
                                                @LeaveChartData.FormatPercent(utilization) utilized
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="row g-4 mb-4">
                <div class="col-xl-5">
                    <div class="chart-panel card h-100">
                        <div class="card-body">
                            <div class="chart-panel-header">
                                <div>
                                    <h2 class="chart-title">Team Leave Balance</h2>
                                    <p class="chart-subtitle">Share of allocated leave that is consumed, pending, or still available</p>
                                </div>
                            </div>
                            <div class="leave-donut-wrap">
                                <div class="chart-canvas-wrap chart-canvas-md">
                                    <canvas id="chart-leave-balance-mix"></canvas>
                                </div>
                                <div class="leave-donut-center" aria-hidden="true">
                                    <span class="leave-donut-center-value">@LeaveChartData.FormatPercent(teamUtilization)</span>
                                    <span class="leave-donut-center-label">utilized</span>
                                </div>
                            </div>
                            <div class="leave-donut-stats">
                                <div class="leave-donut-stat">
                                    <span class="leave-donut-stat-label">Consumed</span>
                                    <strong class="leave-donut-stat-value text-success">@LeaveChartData.FormatDays(filteredUsed)</strong>
                                </div>
                                <div class="leave-donut-stat">
                                    <span class="leave-donut-stat-label">Pending</span>
                                    <strong class="leave-donut-stat-value text-warning">@LeaveChartData.FormatDays(filteredPending)</strong>
                                </div>
                                <div class="leave-donut-stat">
                                    <span class="leave-donut-stat-label">Remaining</span>
                                    <strong class="leave-donut-stat-value">@LeaveChartData.FormatDays(filteredRemaining)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-7">
                    <div class="chart-panel card h-100">
                        <div class="card-body">
                            <div class="chart-panel-header">
                                <div>
                                    <h2 class="chart-title">By Leave Type</h2>
                                    <p class="chart-subtitle">How each leave category contributes to consumption and pending volume</p>
                                </div>
                            </div>
                            @if (leaveTypes.Count == 0)
                            {
                                <p class="text-muted mb-0 py-5 text-center">No leave types configured.</p>
                            }
                            else
                            {
                                <div class="chart-canvas-wrap chart-canvas-md">
                                    <canvas id="chart-leave-type-breakdown"></canvas>
                                </div>
                                <div class="leave-type-rank-list mt-3">
                                    @foreach (var leaveType in leaveTypes)
                                    {
                                        var typeTotal = leaveType.UsedDays + leaveType.PendingDays + leaveType.RemainingDays;
                                        var typeUsedPct = typeTotal > 0 ? (double)(leaveType.UsedDays / typeTotal * 100m) : 0;
                                        var typePendingPct = typeTotal > 0 ? (double)(leaveType.PendingDays / typeTotal * 100m) : 0;
                                        <div class="leave-type-rank-row">
                                            <div class="leave-type-rank-top">
                                                <span class="leave-type-rank-name">@leaveType.LeaveTypeName</span>
                                                <span class="leave-type-rank-meta">
                                                    @LeaveChartData.FormatDays(leaveType.UsedDays) used · @LeaveChartData.FormatDays(leaveType.PendingDays) pending
                                                </span>
                                            </div>
                                            <div class="leave-type-rank-bar">
                                                <span class="leave-type-rank-seg leave-type-rank-seg-used" style="width: @typeUsedPct.ToString("0.##")%"></span>
                                                <span class="leave-type-rank-seg leave-type-rank-seg-pending" style="width: @typePendingPct.ToString("0.##")%"></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="chart-panel card h-100">
                        <div class="card-body">
                            <div class="chart-panel-header">
                                <div>
                                    <h2 class="chart-title">Developer Leave Usage</h2>
                                    <p class="chart-subtitle">Individual breakdown of consumed, pending, and remaining days</p>
                                </div>
                                <span class="chart-panel-badge">@developers.Count developer@(developers.Count == 1 ? "" : "s")</span>
                            </div>
                            @if (developers.Count == 0)
                            {
                                <p class="text-muted mb-0 py-5 text-center">No active developers found.</p>
                            }
                            else
                            {
                                <div class="chart-canvas-wrap chart-canvas-lg">
                                    <canvas id="chart-developer-leave-stacked"></canvas>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="chart-panel card h-100">
                        <div class="card-body">
                            <div class="chart-panel-header">
                                <div>
                                    <h2 class="chart-title">Pending Approvals</h2>
                                    <p class="chart-subtitle">Developers with the highest pending leave volume</p>
                                </div>
                            </div>
                            @if (pendingDevelopers.Count == 0)
                            {
                                <div class="leave-analytics-empty-chart">
                                    <span class="leave-analytics-empty-icon bi-check-circle" aria-hidden="true"></span>
                                    <p class="mb-0">No pending leave requests right now.</p>
                                </div>
                            }
                            else
                            {
                                <div class="chart-canvas-wrap chart-canvas-md">
                                    <canvas id="chart-leave-pending-ranking"></canvas>
                                </div>
                                <p class="chart-footnote mb-0 mt-2">
                                    @LeaveChartData.FormatDays(filteredPending) total day(s) awaiting approval across the team.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card card mb-4">
                <div class="card-body p-0">
                    <div class="card-title-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="card-title mb-0">Developer Leave Balances</h5>
                            <p class="leave-table-subtitle mb-0">Detailed entitlement, usage, and utilization for @_selectedYear</p>
                        </div>
                        @if (_selectedLeaveTypeId.HasValue)
                        {
                            <span class="badge text-bg-light border">@GetSelectedLeaveTypeName()</span>
                        }
                    </div>
                    @if (developers.Count == 0)
                    {
                        <p class="text-muted mb-0 p-4">No developer balances to display.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 analytics-table leave-analytics-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Developer</th>
                                        <th>Allocated</th>
                                        <th>Consumed</th>
                                        <th>Pending</th>
                                        <th>Remaining</th>
                                        <th>Utilization</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var rank = 0;
                                    }
                                    @foreach (var developer in developers)
                                    {
                                        rank++;
                                        var utilization = LeaveChartData.UtilizationPercent(
                                            developer.UsedDays,
                                            developer.PendingDays,
                                            developer.DaysPerYear);
                                        var band = LeaveChartData.UtilizationBand(utilization);
                                        var tone = LeaveChartData.UtilizationTone(utilization);
                                        <tr>
                                            <td><span class="rank-badge">@rank</span></td>
                                            <td>
                                                <strong>@developer.DeveloperName</strong>
                                                <div class="small text-muted">
                                                    @LeaveChartData.FormatDays(developer.UsedDays + developer.PendingDays) of @LeaveChartData.FormatDays(developer.DaysPerYear) committed
                                                </div>
                                            </td>
                                            <td>@LeaveChartData.FormatDays(developer.DaysPerYear)</td>
                                            <td>
                                                <span class="leave-metric-pill leave-metric-pill-success">
                                                    @LeaveChartData.FormatDays(developer.UsedDays)
                                                </span>
                                            </td>
                                            <td>
                                                @if (developer.PendingDays > 0)
                                                {
                                                    <span class="leave-metric-pill leave-metric-pill-warning">
                                                        @LeaveChartData.FormatDays(developer.PendingDays)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>@LeaveChartData.FormatDays(developer.RemainingDays)</td>
                                            <td>
                                                <div class="mini-metric">
                                                    <span>@LeaveChartData.FormatPercent(utilization)</span>
                                                    <div class="mini-bar">
                                                        <div class="mini-bar-fill tone-@tone"
                                                             style="width: @Math.Clamp(utilization, 0, 100).ToString("0.##")%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="perf-pill @($"tone-{tone}")">@band</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LeaveAnalyticsSummaryDto? _summary;
    private IReadOnlyList<(Guid Id, string Name)> _leaveTypes = [];
    private int _selectedYear = DateTime.Today.Year;
    private Guid? _selectedLeaveTypeId;
    private bool _isLoading = true;
    private string? _error;
    private bool _chartsPending;
    private IJSObjectReference? _chartsModule;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalyticsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsPending || _summary is null)
        {
            return;
        }

        _chartsPending = false;
        await RenderChartsAsync();
    }

    private async Task LoadAnalyticsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _summary = await LeaveApi.GetTeamAnalyticsAsync(_selectedYear);
            _leaveTypes = LeaveChartData.GetLeaveTypes(_summary);
            _chartsPending = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _summary = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousYearAsync()
    {
        _selectedYear--;
        await LoadAnalyticsAsync();
    }

    private async Task NextYearAsync()
    {
        _selectedYear++;
        await LoadAnalyticsAsync();
    }

    private async Task GoToCurrentYearAsync()
    {
        _selectedYear = DateTime.Today.Year;
        await LoadAnalyticsAsync();
    }

    private async Task SelectLeaveTypeAsync(Guid? leaveTypeId)
    {
        _selectedLeaveTypeId = leaveTypeId;
        _chartsPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<LeaveTypeSummary> GetFilteredLeaveTypes()
    {
        if (_summary is null)
        {
            return [];
        }

        var leaveTypes = LeaveChartData.AggregateByLeaveType(_summary);
        if (!_selectedLeaveTypeId.HasValue)
        {
            return leaveTypes;
        }

        return leaveTypes.Where(t => t.LeaveTypeId == _selectedLeaveTypeId.Value).ToList();
    }

    private decimal GetFilteredUsed() =>
        LeaveChartData.AggregateByDeveloper(_summary!, _selectedLeaveTypeId).Sum(d => d.UsedDays);

    private decimal GetFilteredPending() =>
        LeaveChartData.AggregateByDeveloper(_summary!, _selectedLeaveTypeId).Sum(d => d.PendingDays);

    private decimal GetFilteredRemaining() =>
        LeaveChartData.AggregateByDeveloper(_summary!, _selectedLeaveTypeId).Sum(d => d.RemainingDays);

    private string GetSelectedLeaveTypeName() =>
        _leaveTypes.FirstOrDefault(t => t.Id == _selectedLeaveTypeId).Name ?? "All types";

    private string GetFilterLabel() =>
        _selectedLeaveTypeId.HasValue ? GetSelectedLeaveTypeName() : "All leave types";

    private async Task RenderChartsAsync()
    {
        if (_summary is null)
        {
            return;
        }

        try
        {
            var module = await GetChartsModuleAsync();
            var developers = LeaveChartData.AggregateByDeveloper(_summary, _selectedLeaveTypeId);
            var leaveTypes = GetFilteredLeaveTypes();

            await module.InvokeVoidAsync(
                "renderLeaveBalanceMix",
                "chart-leave-balance-mix",
                (double)GetFilteredUsed(),
                (double)GetFilteredPending(),
                (double)GetFilteredRemaining());

            if (leaveTypes.Count > 0)
            {
                await module.InvokeVoidAsync(
                    "renderLeaveTypeBreakdown",
                    "chart-leave-type-breakdown",
                    leaveTypes.Select(t => t.LeaveTypeName).ToArray(),
                    leaveTypes.Select(t => (double)t.UsedDays).ToArray(),
                    leaveTypes.Select(t => (double)t.PendingDays).ToArray());
            }

            if (developers.Count > 0)
            {
                var labels = developers.Select(d => Truncate(d.DeveloperName, 16)).ToArray();
                await module.InvokeVoidAsync(
                    "renderDeveloperLeaveStacked",
                    "chart-developer-leave-stacked",
                    labels,
                    developers.Select(d => (double)d.UsedDays).ToArray(),
                    developers.Select(d => (double)d.PendingDays).ToArray(),
                    developers.Select(d => (double)d.RemainingDays).ToArray());
            }

            var pendingDevelopers = developers
                .Where(d => d.PendingDays > 0)
                .OrderByDescending(d => d.PendingDays)
                .Take(8)
                .ToList();

            if (pendingDevelopers.Count > 0)
            {
                await module.InvokeVoidAsync(
                    "renderLeavePendingRanking",
                    "chart-leave-pending-ranking",
                    pendingDevelopers.Select(d => Truncate(d.DeveloperName, 14)).ToArray(),
                    pendingDevelopers.Select(d => (double)d.PendingDays).ToArray());
            }
        }
        catch (JSException)
        {
            // Charts are progressive enhancement.
        }
    }

    private async Task<IJSObjectReference> GetChartsModuleAsync()
    {
        _chartsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/analyticsCharts.js");
        return _chartsModule;
    }

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..(max - 1)] + "…";

    public async ValueTask DisposeAsync()
    {
        if (_chartsModule is not null)
        {
            try
            {
                await _chartsModule.InvokeVoidAsync("destroyAll");
                await _chartsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
