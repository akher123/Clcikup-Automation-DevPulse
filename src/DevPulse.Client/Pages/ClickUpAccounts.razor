@page "/clickup-accounts"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using DevPulse.Client.Models
@inject IClickUpAccountApiClient AccountApi

<PageTitle>@AppBranding.PageTitle("ClickUp Accounts")</PageTitle>

<div class="page-header">
    <div>
        <h1>ClickUp Accounts</h1>
        <p class="text-muted">Manage multiple ClickUp API tokens and test workspace connections.</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowAddForm">Add Account</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_showAddForm)
{
    <div class="form-card card">
        <div class="card-body">
            <h5 class="card-title">Connect ClickUp Workspace</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Account Name</label>
                    <input class="form-control" @bind="_newAccount.Name" placeholder="Client A Production" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Workspace ID</label>
                    <input class="form-control" @bind="_newAccount.WorkspaceId" placeholder="9012345678" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Access Token</label>
                    <input type="password" class="form-control" @bind="_newAccount.AccessToken" placeholder="pk_..." />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" disabled="@_isBusy" @onclick="CreateAccountAsync">Save & Validate</button>
                <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideAddForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <div class="loading-inline">
        <span class="spinner" aria-hidden="true"></span>
        Loading accounts...
    </div>
}
else if (_accounts.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon" aria-hidden="true">&#128268;</div>
        <h5>No ClickUp accounts configured</h5>
        <p class="text-muted mb-3">Add your first workspace token to start building unified developer reports.</p>
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Account</button>
    </div>
}
else
{
    <div class="data-card card">
        <div class="card-body p-0">
            <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Workspace ID</th>
                    <th>Status</th>
                    <th>Last Validated</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr>
                        <td><strong>@account.Name</strong></td>
                        <td><code>@account.WorkspaceId</code></td>
                        <td>
                            <span class="badge @(account.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(account.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (account.LastValidatedAtUtc.HasValue)
                            {
                                <span>@account.LastValidatedAtUtc.Value.ToLocalTime().ToString("g")</span>
                                @if (!string.IsNullOrWhiteSpace(account.LastValidationMessage))
                                {
                                    <div class="small text-muted">@account.LastValidationMessage</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Not validated</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group-actions">
                                <button class="btn btn-sm btn-outline-primary" disabled="@_isBusy" @onclick="() => TestAccountAsync(account.Id)">Test</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@_isBusy" @onclick="() => LoadMembersAsync(account.Id)">Members</button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@_isBusy" @onclick="() => DeleteAccountAsync(account.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
            </div>
        </div>
    </div>
}

@if (_members.Count > 0)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Workspace Members</h5>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in _members)
                        {
                            <tr>
                                <td>@member.ClickUpUserId</td>
                                <td>@member.Username</td>
                                <td>@(member.Email ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<ClickUpAccountDto> _accounts = [];
    private readonly List<ClickUpMemberDto> _members = [];
    private CreateClickUpAccountFormModel _newAccount = new();
    private bool _showAddForm;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        _message = null;

        try
        {
            var accounts = await AccountApi.GetAccountsAsync();
            _accounts.Clear();
            _accounts.AddRange(accounts);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load accounts: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        _showAddForm = true;
        _newAccount = new CreateClickUpAccountFormModel();
        _message = null;
    }

    private void HideAddForm()
    {
        _showAddForm = false;
    }

    private async Task CreateAccountAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            await AccountApi.CreateAccountAsync(_newAccount.ToRequest());
            _showAddForm = false;
            _isError = false;
            _message = "ClickUp account created and validated successfully.";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task TestAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _message = null;

        try
        {
            var result = await AccountApi.TestConnectionAsync(accountId);
            _isError = result is null || !result.IsConnected;
            _message = result?.Message ?? "Connection test failed.";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadMembersAsync(Guid accountId)
    {
        _isBusy = true;
        _message = null;

        try
        {
            var members = await AccountApi.GetMembersAsync(accountId);
            _members.Clear();
            _members.AddRange(members);
            _isError = false;
            _message = $"Loaded {members.Count} workspace members.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await AccountApi.DeleteAccountAsync(accountId);
            _isError = false;
            _message = "Account deleted.";
            _members.Clear();
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
