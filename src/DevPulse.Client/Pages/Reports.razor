@page "/reports"
@attribute [Authorize]
@using DevPulse.Client.Analytics
@using DevPulse.Shared.Constants
@using DevPulse.Shared.Contracts.ClickUp
@using DevPulse.Shared.Contracts.Developers
@using DevPulse.Shared.Contracts.Reports
@implements IAsyncDisposable
@inject IClickUpAccountApiClient AccountApi
@inject IDeveloperApiClient DeveloperApi
@inject IReportApiClient ReportApi
@inject IJSRuntime JS

<PageTitle>@AppBranding.PageTitle("Developer Reports")</PageTitle>

<div class="page-header">
    <div>
        <h1>Developer Reports</h1>
        <p class="text-muted">Filter by date range, ClickUp account, and developers, then generate unified task and productivity reports for MIS.</p>
    </div>
    <a class="btn btn-outline-primary" href="analytics">MIS Analytics</a>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

<div class="filter-card card mb-4">
    <div class="card-body">
        <h5 class="card-title">Report Filters</h5>
        <div class="row g-3 align-items-start">
            <div class="col-md-2">
                <label class="form-label">From</label>
                <input type="date" class="form-control" @bind="_fromDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To</label>
                <input type="date" class="form-control" @bind="_toDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-md-3">
                <label class="form-label">ClickUp Accounts</label>
                @if (_isLoadingAccounts)
                {
                    <LoadingIndicator Text="Loading accounts..." Compact="true" />
                }
                else if (_accounts.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No accounts configured.
                        <AuthorizeView Roles="@AppRoles.Admin">
                            <Authorized>
                                <a href="clickup-accounts">Add an account</a> to get started.
                            </Authorized>
                            <NotAuthorized>
                                Contact an administrator to configure ClickUp accounts.
                            </NotAuthorized>
                        </AuthorizeView>
                    </p>
                }
                else
                {
                    <div class="developer-select border rounded p-2">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="selectAllAccounts"
                                   checked="@_selectAllAccounts"
                                   @onchange="ToggleSelectAllAccounts" />
                            <label class="form-check-label fw-semibold" for="selectAllAccounts">All accounts</label>
                        </div>
                        @foreach (var account in _accounts.Where(a => a.IsActive))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="acct-@account.Id"
                                       checked="@_selectedAccountIds.Contains(account.Id)"
                                       @onchange="() => ToggleAccount(account.Id)" />
                                <label class="form-check-label" for="acct-@account.Id">@account.Name</label>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="col-md-3">
                <label class="form-label">Developers</label>
                @if (_isLoadingDevelopers)
                {
                    <LoadingIndicator Text="Loading developers..." Compact="true" />
                }
                else if (_developers.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No active developers registered.
                        <AuthorizeView Roles="@AppRoles.Admin">
                            <Authorized>
                                <a href="developers">Sync from ClickUp</a> to get started.
                            </Authorized>
                            <NotAuthorized>
                                Contact an administrator to sync developers.
                            </NotAuthorized>
                        </AuthorizeView>
                    </p>
                }
                else if (!AccountFilteredDevelopers().Any())
                {
                    <p class="text-muted mb-0">No developers mapped to the selected account(s).</p>
                }
                else
                {
                    <div class="developer-select border rounded">
                        <div class="developer-select-search p-2 border-bottom">
                            <input type="search"
                                   class="form-control form-control-sm"
                                   placeholder="Filter by name or email..."
                                   autocomplete="off"
                                   @bind="_developerSearch"
                                   @bind:event="oninput"
                                   @bind:after="UpdateSelectAllState" />
                        </div>
                        <div class="developer-select-list p-2">
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="selectAll"
                                       checked="@_selectAll"
                                       @onchange="ToggleSelectAll" />
                                <label class="form-check-label fw-semibold" for="selectAll">Select all</label>
                            </div>
                            @if (!FilteredDevelopers().Any())
                            {
                                <p class="text-muted small mb-0">No developers match your filter.</p>
                            }
                            else
                            {
                                @foreach (var developer in FilteredDevelopers())
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="dev-@developer.Id"
                                               checked="@_selectedDeveloperIds.Contains(developer.Id)"
                                               @onchange="() => ToggleDeveloper(developer.Id)" />
                                        <label class="form-check-label" for="dev-@developer.Id">
                                            @developer.Name
                                            @if (!string.IsNullOrWhiteSpace(developer.Email))
                                            {
                                                <span class="text-muted">(@developer.Email)</span>
                                            }
                                            @if (developer.Mappings.Count == 0)
                                            {
                                                <span class="badge text-bg-warning ms-1">No mappings</span>
                                            }
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="includeClosed" @bind="_includeClosed" />
                    <label class="form-check-label" for="includeClosed">Include closed tasks</label>
                </div>
                <BusyButton CssClass="btn btn-primary w-100"
                            IsBusy="_isBusy"
                            BusyText="Generating..."
                            Disabled="@(!AccountFilteredDevelopers().Any())"
                            OnClick="GenerateReportAsync">
                    Generate Report
                </BusyButton>
            </div>
        </div>
    </div>
</div>

@if (_isBusy && _report is null)
{
    <LoadingIndicator Text="Generating report..." />
}

@if (_report is not null)
{
    var kpis = KpiAnalytics.FromReport(_report);

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="analytics-period-label mb-0">
            <strong>@KpiAnalytics.FormatPeriod(_report.FromDate, _report.ToDate)</strong>
            <span class="text-muted">· report summary</span>
        </div>
        <BusyButton CssClass="btn btn-success"
                    IsBusy="_isExporting"
                    BusyText="Exporting..."
                    OnClick="ExportToExcelAsync">
            Export to Excel
        </BusyButton>
    </div>

    <div class="kpi-grid mb-4">
        <KpiScorecard Label="Completed"
                      Value="@kpis.CompletedCount.ToString()"
                      Hint="@KpiAnalytics.FormatPeriod(kpis.FromDate, kpis.ToDate)"
                      Tone="success" />
        <KpiScorecard Label="Completion Rate"
                      Value="@KpiAnalytics.FormatPercent(kpis.CompletionRate)"
                      Hint="@($"{kpis.CompletedCount} of {kpis.TotalTasks}")"
                      Progress="kpis.CompletionRate"
                      Tone="primary" />
        <KpiScorecard Label="Delivery Health"
                      Value="@KpiAnalytics.FormatPercent(kpis.OnTimeRate)"
                      Hint="on-time vs overdue"
                      Progress="kpis.OnTimeRate"
                      Tone="accent" />
        <KpiScorecard Label="Avg. Cycle"
                      Value="@KpiAnalytics.FormatDays(kpis.AverageCycleDays)"
                      Hint="completion days"
                      Tone="neutral" />
        <KpiScorecard Label="In Progress"
                      Value="@kpis.InProgressCount.ToString()"
                      Hint="created in selected dates"
                      Tone="warning" />
        <KpiScorecard Label="Overdue"
                      Value="@kpis.OverdueCount.ToString()"
                      Hint="@($"{kpis.ActiveDevelopers} developer(s)")"
                      Tone="@(kpis.OverdueCount > 0 ? "danger" : "neutral")" />
    </div>

    @if (_report.Developers.Any(d => d.TotalTasks > 0))
    {
        <div class="data-card card mb-4">
            <div class="card-body p-0">
                <h5 class="card-title card-title-bar">Productivity Summary</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Developer</th>
                                <th>Total</th>
                                <th>Completed</th>
                                <th>In Progress</th>
                                <th>Completion</th>
                                <th>Delivery</th>
                                <th>Subtasks</th>
                                <th>Workspaces</th>
                                <th>Projects</th>
                                <th>Overdue</th>
                                <th>On Time</th>
                                <th>Avg. Completion</th>
                                <th>Workspace Breakdown</th>
                                <th>Project Breakdown</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var summary in _report.Developers.Where(d => d.TotalTasks > 0))
                            {
                                var completionRate = KpiAnalytics.Rate(summary.CompletedCount, summary.TotalTasks);
                                var deliveryHealth = summary.OnTimeCompletedCount + summary.OverdueCount > 0
                                    ? KpiAnalytics.Rate(summary.OnTimeCompletedCount, summary.OnTimeCompletedCount + summary.OverdueCount)
                                    : (double?)null;
                                <tr>
                                    <td>
                                        <strong>@summary.DeveloperName</strong>
                                        @if (!string.IsNullOrWhiteSpace(summary.Email))
                                        {
                                            <div class="small text-muted">@summary.Email</div>
                                        }
                                    </td>
                                    <td><span class="badge text-bg-primary">@summary.TotalTasks</span></td>
                                    <td><span class="badge text-bg-success">@summary.CompletedCount</span></td>
                                    <td><span class="badge text-bg-warning">@summary.InProgressCount</span></td>
                                    <td>@KpiAnalytics.FormatPercent(completionRate)</td>
                                    <td>@KpiAnalytics.FormatPercent(deliveryHealth)</td>
                                    <td><span class="badge text-bg-secondary">@summary.ChildTaskCount</span></td>
                                    <td>@summary.WorkspaceCount</td>
                                    <td>@summary.ProjectCount</td>
                                    <td>
                                        @if (summary.OverdueCount > 0)
                                        {
                                            <span class="badge text-bg-danger">@summary.OverdueCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td>
                                        @if (summary.OnTimeCompletedCount > 0)
                                        {
                                            <span class="badge text-bg-success">@summary.OnTimeCompletedCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td>
                                        @if (summary.AverageCompletionDays.HasValue)
                                        {
                                            <span>@summary.AverageCompletionDays.Value days</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var workspace in summary.ByWorkspace)
                                        {
                                            <span class="badge text-bg-light text-dark me-1 mb-1">
                                                @workspace.AccountName: @workspace.TaskCount
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var project in summary.ByProject)
                                        {
                                            <span class="badge text-bg-light text-dark me-1 mb-1">
                                                @project.ProjectName: @project.TaskCount
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="data-card card">
        <div class="card-body p-0">
            <h5 class="card-title card-title-bar">Task Details (@_report.Tasks.Count)</h5>
            @if (_report.Tasks.Count == 0)
            {
                <p class="text-muted mb-0 p-4">No tasks completed in the selected date range for the chosen developers.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Developer</th>
                                <th>Workspace</th>
                                <th>Project</th>
                                <th>Folder</th>
                                <th>Kind</th>
                                <th>Task</th>
                                <th>Priority</th>
                                <th>Created</th>
                                <th>Due</th>
                                <th>Status</th>
                                <th>Completed</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in _report.Tasks)
                            {
                                <tr>
                                    <td>@task.DeveloperName</td>
                                    <td>@task.AccountName</td>
                                    <td>@(string.IsNullOrWhiteSpace(task.ProjectName) ? "—" : task.ProjectName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(task.FolderName) ? "—" : task.FolderName)</td>
                                    <td>
                                        @if (task.IsSubtask)
                                        {
                                            <span class="badge text-bg-secondary">Subtask</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-info">@task.TaskType</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(task.Url))
                                        {
                                            <a href="@task.Url" target="_blank" rel="noopener">@task.TaskName</a>
                                        }
                                        else
                                        {
                                            @task.TaskName
                                        }
                                        @if (!string.IsNullOrWhiteSpace(task.ListName))
                                        {
                                            <div class="small text-muted">@task.ListName</div>
                                        }
                                        @if (task.IsSubtask && !string.IsNullOrWhiteSpace(task.ParentTaskName))
                                        {
                                            <div class="small text-muted">Parent: @task.ParentTaskName</div>
                                        }
                                        else if (task.IsSubtask && !string.IsNullOrWhiteSpace(task.ParentTaskId))
                                        {
                                            <div class="small text-muted">Parent: @task.ParentTaskId</div>
                                        }
                                    </td>
                                    <td>@FormatPriority(task.Priority)</td>
                                    <td>@FormatUnixDate(task.DateCreated)</td>
                                    <td class="@(IsTaskOverdue(task) ? "text-danger fw-semibold" : null)">@FormatUnixDate(task.DueDate)</td>
                                    <td>
                                        @if (task.IsCompleted)
                                        {
                                            <span class="badge text-bg-success">@(task.Status ?? "complete")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning">@(task.Status ?? "in progress")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (task.IsCompleted)
                                        {
                                            @FormatUnixDate(task.DateDone)
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (task.CompletionDays.HasValue)
                                        {
                                            <span>@task.CompletionDays.Value d</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly List<ClickUpAccountDto> _accounts = [];
    private readonly List<DeveloperDto> _developers = [];
    private readonly HashSet<Guid> _selectedAccountIds = [];
    private readonly HashSet<Guid> _selectedDeveloperIds = [];
    private DeveloperReportResponse? _report;
    private DateTime _fromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _toDate = DateTime.Today;
    private bool _includeClosed = true;
    private bool _selectAllAccounts;
    private bool _selectAll;
    private bool _isLoadingAccounts = true;
    private bool _isLoadingDevelopers = true;
    private bool _isBusy;
    private bool _isExporting;
    private bool _isError;
    private string? _message;
    private string _developerSearch = string.Empty;
    private IJSObjectReference? _fileDownloadModule;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAccountsAsync(), LoadDevelopersAsync());
        SelectAllFilteredDevelopers();
    }

    private IEnumerable<DeveloperDto> AccountFilteredDevelopers()
    {
        IEnumerable<DeveloperDto> results = _developers;

        if (_selectedAccountIds.Count == 0)
        {
            return results;
        }

        return results.Where(d =>
            d.Mappings.Any(m => _selectedAccountIds.Contains(m.ClickUpAccountId)));
    }

    private IEnumerable<DeveloperDto> FilteredDevelopers()
    {
        IEnumerable<DeveloperDto> results = AccountFilteredDevelopers();

        if (!string.IsNullOrWhiteSpace(_developerSearch))
        {
            results = results.Where(d =>
                d.Name.Contains(_developerSearch, StringComparison.OrdinalIgnoreCase)
                || (d.Email?.Contains(_developerSearch, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return results;
    }

    private async Task LoadAccountsAsync()
    {
        _isLoadingAccounts = true;

        try
        {
            var accounts = await AccountApi.GetAccountsAsync();
            _accounts.Clear();
            _accounts.AddRange(accounts);

            _selectedAccountIds.Clear();
            foreach (var account in _accounts.Where(a => a.IsActive))
            {
                _selectedAccountIds.Add(account.Id);
            }
            _selectAllAccounts = _selectedAccountIds.Count > 0;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load accounts: {ex.Message}";
        }
        finally
        {
            _isLoadingAccounts = false;
        }
    }

    private async Task LoadDevelopersAsync()
    {
        _isLoadingDevelopers = true;

        try
        {
            var developers = await DeveloperApi.GetDevelopersAsync();
            _developers.Clear();
            _developers.AddRange(developers.Where(d => d.IsActive));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load developers: {ex.Message}";
        }
        finally
        {
            _isLoadingDevelopers = false;
        }
    }

    private void SelectAllFilteredDevelopers()
    {
        _selectedDeveloperIds.Clear();
        foreach (var developer in AccountFilteredDevelopers())
        {
            _selectedDeveloperIds.Add(developer.Id);
        }

        UpdateSelectAllState();
    }

    private void UpdateSelectAllState()
    {
        var filtered = FilteredDevelopers().ToList();
        _selectAll = filtered.Count > 0 && filtered.All(d => _selectedDeveloperIds.Contains(d.Id));
    }

    private void ToggleSelectAllAccounts(ChangeEventArgs args)
    {
        var isChecked = args.Value is true;
        _selectAllAccounts = isChecked;
        _selectedAccountIds.Clear();

        if (isChecked)
        {
            foreach (var account in _accounts.Where(a => a.IsActive))
            {
                _selectedAccountIds.Add(account.Id);
            }
        }

        SelectAllFilteredDevelopers();
    }

    private void ToggleAccount(Guid accountId)
    {
        if (!_selectedAccountIds.Add(accountId))
        {
            _selectedAccountIds.Remove(accountId);
        }

        var activeCount = _accounts.Count(a => a.IsActive);
        _selectAllAccounts = activeCount > 0 && _selectedAccountIds.Count == activeCount;
        SelectAllFilteredDevelopers();
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var isChecked = args.Value is true;
        _selectAll = isChecked;
        var visibleIds = FilteredDevelopers().Select(d => d.Id).ToHashSet();

        if (isChecked)
        {
            foreach (var id in visibleIds)
            {
                _selectedDeveloperIds.Add(id);
            }
        }
        else
        {
            _selectedDeveloperIds.RemoveWhere(visibleIds.Contains);
        }
    }

    private void ToggleDeveloper(Guid developerId)
    {
        if (!_selectedDeveloperIds.Add(developerId))
        {
            _selectedDeveloperIds.Remove(developerId);
        }

        UpdateSelectAllState();
    }

    private async Task GenerateReportAsync()
    {
        if (_selectedDeveloperIds.Count == 0)
        {
            _isError = true;
            _message = "Select at least one developer.";
            return;
        }

        var fromDate = DateOnly.FromDateTime(_fromDate);
        var toDate = DateOnly.FromDateTime(_toDate);

        if (fromDate > toDate)
        {
            _isError = true;
            _message = "From date must be on or before to date.";
            return;
        }

        _isBusy = true;
        _message = null;
        _report = null;

        try
        {
            IReadOnlyList<Guid>? accountIds = _selectedAccountIds.Count > 0
                ? _selectedAccountIds.ToList()
                : null;

            var request = new DeveloperReportRequest(
                _selectedDeveloperIds.ToList(),
                fromDate,
                toDate,
                _includeClosed,
                accountIds);

            _report = await ReportApi.GenerateDeveloperReportAsync(request);
            _isError = false;
            _message = $"Report generated for {FormatPeriod(fromDate, toDate)}.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ExportToExcelAsync()
    {
        if (_report is null)
        {
            return;
        }

        _isExporting = true;
        _message = null;

        try
        {
            var fileBytes = await ReportApi.ExportDeveloperReportToExcelAsync(_report);
            var fileName = $"{AppBranding.CompanyName}-Developer-Work-{_report.FromDate:yyyy-MM-dd}_to_{_report.ToDate:yyyy-MM-dd}.xlsx";
            const string contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            var base64 = Convert.ToBase64String(fileBytes);
            var module = await GetFileDownloadModuleAsync();
            await module.InvokeVoidAsync("downloadFromBytes", fileName, contentType, base64);
            _isError = false;
            _message = "Report exported to Excel.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isExporting = false;
        }
    }

    private static string FormatPeriod(DateOnly fromDate, DateOnly toDate)
    {
        if (fromDate == toDate)
        {
            return fromDate.ToString("MMM d, yyyy");
        }

        if (fromDate.Year == toDate.Year && fromDate.Month == toDate.Month && fromDate.Day == 1
            && toDate.Day == DateTime.DaysInMonth(toDate.Year, toDate.Month))
        {
            return fromDate.ToString("MMMM yyyy");
        }

        return $"{fromDate:MMM d, yyyy} – {toDate:MMM d, yyyy}";
    }

    private static string FormatUnixDate(long? unixMs)
    {
        if (!unixMs.HasValue)
        {
            return "—";
        }

        return DateTimeOffset.FromUnixTimeMilliseconds(unixMs.Value).ToLocalTime().ToString("MMM d, yyyy");
    }

    private static string FormatPriority(string? priority)
    {
        if (string.IsNullOrWhiteSpace(priority))
        {
            return "—";
        }

        var trimmed = priority.Trim();
        return trimmed.Length == 1
            ? trimmed.ToUpperInvariant()
            : char.ToUpper(trimmed[0]) + trimmed[1..].ToLowerInvariant();
    }

    private static bool IsTaskOverdue(DeveloperReportTaskDto task)
    {
        if (!task.DueDate.HasValue)
        {
            return false;
        }

        if (task.IsCompleted)
        {
            return task.DateDone.HasValue && task.DateDone.Value > task.DueDate.Value;
        }

        return task.DueDate.Value < DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    }

    private async Task<IJSObjectReference> GetFileDownloadModuleAsync()
    {
        _fileDownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
        return _fileDownloadModule;
    }

    public async ValueTask DisposeAsync()
    {
        if (_fileDownloadModule is not null)
        {
            await _fileDownloadModule.DisposeAsync();
        }
    }
}
