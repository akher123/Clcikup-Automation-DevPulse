@page "/developers"
@using DevPulse.Shared.Contracts.Developers
@inject IDeveloperApiClient DeveloperApi

<PageTitle>Developers - DevPulse</PageTitle>

<div class="page-header">
    <div>
        <h1>Developers</h1>
        <p class="text-muted">Manage the developer registry and cross-workspace ClickUp mappings.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" disabled="@_isBusy" @onclick="SyncFromClickUpAsync">Sync from ClickUp</button>
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Developer</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_showAddForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add Developer</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_newDeveloper.Name" placeholder="Jane Doe" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="_newDeveloper.Email" placeholder="jane@example.com" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" disabled="@_isBusy" @onclick="CreateDeveloperAsync">Save</button>
                <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideAddForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <p>Loading developers...</p>
}
else if (_developers.Count == 0)
{
    <div class="empty-state card">
        <div class="card-body">
            <h5>No developers registered</h5>
            <p class="text-muted mb-0">
                Sync members from your connected ClickUp workspaces to build the developer registry automatically.
            </p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Workspace Mappings</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var developer in _developers)
                {
                    <tr>
                        <td><strong>@developer.Name</strong></td>
                        <td>@(developer.Email ?? "—")</td>
                        <td>
                            <span class="badge @(developer.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(developer.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (developer.Mappings.Count == 0)
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                @foreach (var mapping in developer.Mappings)
                                {
                                    <span class="badge text-bg-light text-dark me-1 mb-1" title="ClickUp User ID: @mapping.ClickUpUserId">
                                        @mapping.AccountName
                                    </span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" disabled="@_isBusy" @onclick="() => DeleteDeveloperAsync(developer.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<DeveloperDto> _developers = [];
    private CreateDeveloperFormModel _newDeveloper = new();
    private bool _showAddForm;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevelopersAsync();
    }

    private async Task LoadDevelopersAsync()
    {
        _isLoading = true;
        _message = null;

        try
        {
            var developers = await DeveloperApi.GetDevelopersAsync();
            _developers.Clear();
            _developers.AddRange(developers);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load developers: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        _showAddForm = true;
        _newDeveloper = new CreateDeveloperFormModel();
        _message = null;
    }

    private void HideAddForm()
    {
        _showAddForm = false;
    }

    private async Task CreateDeveloperAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.CreateDeveloperAsync(_newDeveloper.ToRequest());
            _showAddForm = false;
            _isError = false;
            _message = "Developer created successfully.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SyncFromClickUpAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            var result = await DeveloperApi.SyncFromClickUpAsync();
            _isError = false;
            _message = result is null
                ? "Sync completed."
                : $"Sync complete: {result.DevelopersCreated} created, {result.DevelopersUpdated} updated, {result.MappingsAdded} mappings added.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteDeveloperAsync(Guid id)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.DeleteDeveloperAsync(id);
            _isError = false;
            _message = "Developer deleted.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class CreateDeveloperFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }

        public CreateDeveloperRequest ToRequest() => new(Name, Email);
    }
}
