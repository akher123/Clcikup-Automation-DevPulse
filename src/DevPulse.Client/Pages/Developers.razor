@page "/developers"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using DevPulse.Shared.Constants
@using DevPulse.Shared.Contracts.ClickUp
@using DevPulse.Shared.Contracts.Developers
@inject IDeveloperApiClient DeveloperApi
@inject IClickUpAccountApiClient ClickUpAccountApi

<PageTitle>@AppBranding.PageTitle("Developers")</PageTitle>

<div class="page-header">
    <div>
        <h1>Developers</h1>
        <p class="text-muted">Manage the developer registry and cross-workspace ClickUp mappings.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        @if (_clickUpAccounts.Count > 0)
        {
            <SearchableAccountSelect Accounts="_clickUpAccounts"
                                     SelectedValue="_selectedAccountId"
                                     SelectedValueChanged="OnAccountSelectionChanged"
                                     CssClass="sync-account-select"
                                     Disabled="@_isBusy" />
        }
        <BusyButton CssClass="btn btn-outline-primary" IsBusy="_isBusy" BusyText="Syncing..." OnClick="SyncFromClickUpAsync" Disabled="@(_clickUpAccounts.Count == 0)">
            Sync from ClickUp
        </BusyButton>
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Developer</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_isBusy && !_isLoading)
{
    <LoadingIndicator Text="Processing..." />
}

@if (_showAddForm)
{
    <div class="form-card card">
        <div class="card-body">
            <h5 class="card-title">Add Developer</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_newDeveloper.Name" placeholder="Jane Doe" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="_newDeveloper.Email" placeholder="jane@example.com" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Work role</label>
                    <select class="form-select" @bind="_newDeveloper.WorkRole">
                        <option value="@WorkRole.Developer">Developer</option>
                        <option value="@WorkRole.QA">QA</option>
                    </select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <BusyButton CssClass="btn btn-success" IsBusy="_isBusy" BusyText="Saving..." OnClick="CreateDeveloperAsync">Save</BusyButton>
                <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideAddForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_mappingDeveloperId.HasValue)
{
    <div class="form-card card">
        <div class="card-body">
            <h5 class="card-title">Map to ClickUp Workspace</h5>
            <p class="text-muted small mb-3">
                Resolves the ClickUp user ID from the email address and links it to this developer.
            </p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Workspace</label>
                    <select class="form-select" @bind="_mappingForm.WorkspaceId">
                        <option value="">Select workspace...</option>
                        @foreach (var account in _clickUpAccounts)
                        {
                            <option value="@account.WorkspaceId">@account.Name (@account.WorkspaceId)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="_mappingForm.Email" placeholder="jane@example.com" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <BusyButton CssClass="btn btn-success" IsBusy="_isBusy" BusyText="Mapping..." OnClick="AddMappingByEmailAsync">Resolve &amp; Map</BusyButton>
                <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="CancelMappingForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <LoadingIndicator Text="Loading developers..." />
}
else if (_developers.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon" aria-hidden="true">&#128101;</div>
        <h5>No developers registered</h5>
        <p class="text-muted mb-3">
            Sync members from your connected ClickUp workspaces to build the developer registry automatically.
        </p>
        <BusyButton CssClass="btn btn-outline-primary me-2" IsBusy="_isBusy" BusyText="Syncing..." OnClick="SyncFromClickUpAsync" Disabled="@(_clickUpAccounts.Count == 0)">
            Sync from ClickUp
        </BusyButton>
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Developer</button>
    </div>
}
else
{
    <div class="data-card card">
        <div class="card-body p-0">
            <div class="developer-filter-bar">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label mb-1" for="developerSearch">Search</label>
                        <input id="developerSearch"
                               type="search"
                               class="form-control form-control-sm"
                               placeholder="Name or email..."
                               @bind="_developerSearch"
                               @bind:event="oninput" />
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label mb-1" for="developerRoleFilter">Role</label>
                        <select id="developerRoleFilter" class="form-select form-select-sm" @bind="_roleFilter">
                            <option value="all">All</option>
                            <option value="developer">Developer</option>
                            <option value="qa">QA</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label mb-1" for="developerStatusFilter">Status</label>
                        <select id="developerStatusFilter" class="form-select form-select-sm" @bind="_statusFilter">
                            <option value="all">All</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-5 col-lg-5">
                        <p class="text-muted small mb-0">
                            Showing @FilteredDevelopers().Count() of @_developers.Count developer@(_developers.Count == 1 ? "" : "s")
                            @if (HasActiveFilters)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" @onclick="ClearFilters">Clear filters</button>
                            }
                        </p>
                    </div>
                </div>
            </div>
            @if (!FilteredDevelopers().Any())
            {
                <div class="empty-state border-0">
                    <h5>No developers match your filters</h5>
                    <p class="text-muted mb-3">Try a different ClickUp account or search term.</p>
                    @if (HasActiveFilters)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear filters</button>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Workspace Mappings</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var developer in FilteredDevelopers())
                            {
                                <tr>
                                    <td><strong>@developer.Name</strong></td>
                                    <td>@(developer.Email ?? "—")</td>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                style="width: auto; display: inline-block;"
                                                disabled="@_isBusy"
                                                value="@developer.WorkRole"
                                                @onchange="e => SetWorkRoleAsync(developer, e.Value?.ToString())">
                                            <option value="@WorkRole.Developer">Developer</option>
                                            <option value="@WorkRole.QA">QA</option>
                                        </select>
                                    </td>
                                    <td>
                                        <span class="badge @(developer.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                            @(developer.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        @if (developer.Mappings.Count == 0)
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                        else
                                        {
                                            @foreach (var mapping in developer.Mappings)
                                            {
                                                <span class="badge text-bg-light text-dark me-1 mb-1" title="ClickUp User ID: @mapping.ClickUpUserId">
                                                    @mapping.AccountName
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group-actions">
                                            <button class="btn btn-sm btn-outline-primary" disabled="@_isBusy" @onclick="() => ShowMappingForm(developer)">Map Workspace</button>
                                            @if (developer.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" disabled="@_isBusy" @onclick="() => SetDeveloperActiveAsync(developer, false)" title="Mark inactive without affecting reports or analytics">
                                                    Set Inactive
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success" disabled="@_isBusy" @onclick="() => SetDeveloperActiveAsync(developer, true)">
                                                    Set Active
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger" disabled="@_isBusy" @onclick="() => DeleteDeveloperAsync(developer.Id)">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly List<DeveloperDto> _developers = [];
    private readonly List<ClickUpAccountDto> _clickUpAccounts = [];
    private CreateDeveloperFormModel _newDeveloper = new();
    private MappingFormModel _mappingForm = new();
    private Guid? _mappingDeveloperId;
    private string _selectedAccountId = string.Empty;
    private string _developerSearch = string.Empty;
    private string _statusFilter = "all";
    private string _roleFilter = "all";
    private bool _showAddForm;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadDevelopersAsync(), LoadClickUpAccountsAsync());
    }

    private async Task LoadClickUpAccountsAsync()
    {
        try
        {
            var accounts = await ClickUpAccountApi.GetAccountsAsync();
            _clickUpAccounts.Clear();
            _clickUpAccounts.AddRange(accounts.Where(a => a.IsActive));
            if (_clickUpAccounts.Count == 1)
            {
                _selectedAccountId = _clickUpAccounts[0].Id.ToString();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load ClickUp workspaces: {ex.Message}";
        }
    }

    private async Task LoadDevelopersAsync()
    {
        _isLoading = true;
        _message = null;

        try
        {
            var developers = await DeveloperApi.GetDevelopersAsync();
            _developers.Clear();
            _developers.AddRange(developers);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load developers: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        _showAddForm = true;
        _newDeveloper = new CreateDeveloperFormModel();
        _message = null;
    }

    private void HideAddForm()
    {
        _showAddForm = false;
    }

    private void ShowMappingForm(DeveloperDto developer)
    {
        _showAddForm = false;
        _mappingDeveloperId = developer.Id;
        _mappingForm = new MappingFormModel
        {
            Email = developer.Email ?? string.Empty,
            WorkspaceId = _clickUpAccounts.Count == 1 ? _clickUpAccounts[0].WorkspaceId : string.Empty
        };
        _message = null;
    }

    private void CancelMappingForm()
    {
        _mappingDeveloperId = null;
        _mappingForm = new MappingFormModel();
    }

    private async Task AddMappingByEmailAsync()
    {
        if (!_mappingDeveloperId.HasValue)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_mappingForm.WorkspaceId))
        {
            _isError = true;
            _message = "Please select a workspace.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_mappingForm.Email))
        {
            _isError = true;
            _message = "Email is required to resolve the ClickUp user.";
            return;
        }

        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.AddMappingByEmailAsync(
                _mappingDeveloperId.Value,
                new AddDeveloperMappingByEmailRequest(_mappingForm.WorkspaceId.Trim(), _mappingForm.Email.Trim()));

            _mappingDeveloperId = null;
            _mappingForm = new MappingFormModel();
            _isError = false;
            _message = "Developer mapped to ClickUp workspace successfully.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateDeveloperAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.CreateDeveloperAsync(_newDeveloper.ToRequest());
            _showAddForm = false;
            _isError = false;
            _message = "Developer created successfully.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task OnAccountSelectionChanged(string? accountId)
    {
        _selectedAccountId = accountId ?? string.Empty;
        return Task.CompletedTask;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_developerSearch)
        || !string.IsNullOrWhiteSpace(_selectedAccountId)
        || !string.Equals(_statusFilter, "all", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(_roleFilter, "all", StringComparison.OrdinalIgnoreCase);

    private void ClearFilters()
    {
        _developerSearch = string.Empty;
        _selectedAccountId = string.Empty;
        _statusFilter = "all";
        _roleFilter = "all";
    }

    private IEnumerable<DeveloperDto> FilteredDevelopers()
    {
        IEnumerable<DeveloperDto> results = _developers;

        if (Guid.TryParse(_selectedAccountId, out var accountId))
        {
            results = results.Where(d =>
                d.Mappings.Any(m => m.ClickUpAccountId == accountId));
        }

        if (string.Equals(_statusFilter, "active", StringComparison.OrdinalIgnoreCase))
        {
            results = results.Where(d => d.IsActive);
        }
        else if (string.Equals(_statusFilter, "inactive", StringComparison.OrdinalIgnoreCase))
        {
            results = results.Where(d => !d.IsActive);
        }

        if (string.Equals(_roleFilter, "developer", StringComparison.OrdinalIgnoreCase))
        {
            results = results.Where(d => d.WorkRole == WorkRole.Developer);
        }
        else if (string.Equals(_roleFilter, "qa", StringComparison.OrdinalIgnoreCase))
        {
            results = results.Where(d => d.WorkRole == WorkRole.QA);
        }

        if (!string.IsNullOrWhiteSpace(_developerSearch))
        {
            results = results.Where(d =>
                d.Name.Contains(_developerSearch, StringComparison.OrdinalIgnoreCase)
                || (d.Email?.Contains(_developerSearch, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return results;
    }

    private async Task SyncFromClickUpAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            SyncFromClickUpRequest? request = Guid.TryParse(_selectedAccountId, out var accountId)
                ? new SyncFromClickUpRequest(accountId)
                : null;

            var result = await DeveloperApi.SyncFromClickUpAsync(request);
            _isError = false;
            var accountLabel = Guid.TryParse(_selectedAccountId, out var selectedId)
                ? _clickUpAccounts.FirstOrDefault(a => a.Id == selectedId)?.Name ?? "selected account"
                : "all accounts";
            _message = result is null
                ? $"Sync from {accountLabel} completed."
                : $"Sync from {accountLabel} complete: {result.DevelopersCreated} created, {result.DevelopersUpdated} updated, {result.MappingsAdded} mappings added.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetDeveloperActiveAsync(DeveloperDto developer, bool isActive)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.UpdateDeveloperAsync(
                developer.Id,
                new UpdateDeveloperRequest(developer.Name, developer.Email, isActive, developer.WorkRole));

            _isError = false;
            _message = isActive
                ? $"{developer.Name} marked active."
                : $"{developer.Name} marked inactive. Reports and analytics are unchanged.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetWorkRoleAsync(DeveloperDto developer, string? roleValue)
    {
        if (!Enum.TryParse<WorkRole>(roleValue, out var role) || role == developer.WorkRole)
        {
            return;
        }

        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.UpdateDeveloperAsync(
                developer.Id,
                new UpdateDeveloperRequest(developer.Name, developer.Email, developer.IsActive, role));

            _isError = false;
            _message = $"{developer.Name} set as {role}.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteDeveloperAsync(Guid id)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await DeveloperApi.DeleteDeveloperAsync(id);
            _isError = false;
            _message = "Developer deleted.";
            await LoadDevelopersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class CreateDeveloperFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }
        public WorkRole WorkRole { get; set; } = WorkRole.Developer;

        public CreateDeveloperRequest ToRequest() => new(Name, Email, WorkRole);
    }

    private sealed class MappingFormModel
    {
        public string WorkspaceId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
