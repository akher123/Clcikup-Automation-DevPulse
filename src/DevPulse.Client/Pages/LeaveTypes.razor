@page "/leave-types"
@attribute [Authorize(Policy = "AdminOnly")]
@inject ILeaveApiClient LeaveApi

<PageTitle>@AppBranding.PageTitle("Leave Types")</PageTitle>

<div class="page-header">
    <div>
        <h1>Leave Types</h1>
        <p class="text-muted">Configure leave categories, yearly allowance, and day-counting policy.</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowAddForm">Add Leave Type</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_showForm)
{
    <div class="form-card card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(_editingId.HasValue ? "Edit Leave Type" : "New Leave Type")</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_name" placeholder="Annual Leave" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Days per year</label>
                    <input type="number" class="form-control" min="1" @bind="_daysPerYear" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Counting mode</label>
                    <select class="form-select" @bind="_countingMode">
                        <option value="@LeaveCountingModeDto.WorkingDays">Working days</option>
                        <option value="@LeaveCountingModeDto.CalendarDays">Calendar days</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="leaveTypeActive" @bind="_isActive" />
                        <label class="form-check-label" for="leaveTypeActive">Active</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Policy notes</label>
                    <textarea class="form-control" rows="2" @bind="_policyNotes" placeholder="Optional policy description"></textarea>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <BusyButton CssClass="btn btn-success" IsBusy="_isBusy" BusyText="Saving..." OnClick="SaveAsync">
                    @(_editingId.HasValue ? "Update" : "Create")
                </BusyButton>
                <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <LoadingIndicator Text="Loading leave types..." />
}
else
{
    <div class="data-card card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Days/Year</th>
                            <th>Counting</th>
                            <th>Active</th>
                            <th>Policy</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _leaveTypes)
                        {
                            <tr>
                                <td>@type.Name</td>
                                <td>@type.DaysPerYear</td>
                                <td>@(type.CountingMode == LeaveCountingModeDto.WorkingDays ? "Working days" : "Calendar days")</td>
                                <td>
                                    <span class="badge @(type.IsActive ? "bg-success" : "bg-secondary")">
                                        @(type.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-muted small">@(type.PolicyNotes ?? "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(type)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(type.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<LeaveTypeDto> _leaveTypes = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _showForm;
    private bool _isError;
    private string? _message;
    private Guid? _editingId;
    private string _name = string.Empty;
    private int _daysPerYear = 14;
    private LeaveCountingModeDto _countingMode = LeaveCountingModeDto.WorkingDays;
    private string? _policyNotes;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _leaveTypes = (await LeaveApi.GetLeaveTypesAsync()).ToList();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        _editingId = null;
        _name = string.Empty;
        _daysPerYear = 14;
        _countingMode = LeaveCountingModeDto.WorkingDays;
        _policyNotes = null;
        _isActive = true;
        _showForm = true;
    }

    private void Edit(LeaveTypeDto type)
    {
        _editingId = type.Id;
        _name = type.Name;
        _daysPerYear = type.DaysPerYear;
        _countingMode = type.CountingMode;
        _policyNotes = type.PolicyNotes;
        _isActive = type.IsActive;
        _showForm = true;
    }

    private void HideForm() => _showForm = false;

    private async Task SaveAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            if (_editingId.HasValue)
            {
                await LeaveApi.UpdateLeaveTypeAsync(_editingId.Value, new UpdateLeaveTypeRequest(
                    _name, _daysPerYear, _countingMode, _policyNotes, _isActive));
                ShowMessage("Leave type updated.", false);
            }
            else
            {
                await LeaveApi.CreateLeaveTypeAsync(new CreateLeaveTypeRequest(
                    _name, _daysPerYear, _countingMode, _policyNotes, _isActive));
                ShowMessage("Leave type created.", false);
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await LeaveApi.DeleteLeaveTypeAsync(id);
            ShowMessage("Leave type deleted.", false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
}
