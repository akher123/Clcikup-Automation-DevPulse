@page "/"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using DevPulse.Client.Analytics
@using DevPulse.Shared.Constants
@using DevPulse.Shared.Contracts.Reports
@inject IDeveloperApiClient DeveloperApi
@inject IReportApiClient ReportApi

<PageTitle>@AppBranding.PageTitle("Dashboard")</PageTitle>

<div class="analytics-hero analytics-hero-home">
    <div class="analytics-hero-copy">
        <p class="analytics-eyebrow">@AppBranding.CompanyName · MIS Overview</p>
        <h1>Developer Performance</h1>
        <p class="analytics-lead">
            Unified KPI view across ClickUp workspaces — throughput, delivery health, and team workload at a glance.
        </p>
        <div class="analytics-hero-actions-inline">
            <a class="btn btn-primary" href="analytics">Open Analytics</a>
            <a class="btn btn-outline-light" href="reports">Full Reports</a>
        </div>
    </div>
</div>

@if (_isLoadingReport)
{
    <LoadingIndicator Text="Loading developer work summary..." />
}
else if (_kpis is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="analytics-period-label mb-0">
            <span>@KpiAnalytics.FormatPeriod(_kpis.FromDate, _kpis.ToDate)</span>
            <span class="text-muted">· month to date</span>
            @if (_previousKpis is not null)
            {
                <span class="text-muted"> · vs @_comparisonPeriodLabel</span>
            }
        </div>
        <a class="btn btn-sm btn-outline-primary" href="analytics">Explore KPIs</a>
    </div>

    @if (_slaChecks.Count > 0)
    {
        <SlaStatusBanner Checks="_slaChecks" PeriodLabel="Month to date" />
    }

    <div class="kpi-grid mb-4">
        <KpiScorecard Label="Completed"
                      Value="@_kpis.CompletedCount.ToString()"
                      Hint="across all workspaces"
                      Tone="success"
                      Trend="@FormatCountTrend(_kpis.CompletedCount, _previousKpis?.CompletedCount, higherIsBetter: true)" />
        <KpiScorecard Label="Completion Rate"
                      Value="@KpiAnalytics.FormatPercent(_kpis.CompletionRate)"
                      Hint="@($"{_kpis.CompletedCount}/{_kpis.TotalTasks} tasks")"
                      Progress="_kpis.CompletionRate"
                      Tone="primary"
                      Trend="@FormatPercentTrend(_kpis.CompletionRate, _previousKpis?.CompletionRate, higherIsBetter: true)" />
        <KpiScorecard Label="Delivery Health"
                      Value="@KpiAnalytics.FormatPercent(_kpis.OnTimeRate)"
                      Hint="on-time vs overdue"
                      Progress="_kpis.OnTimeRate"
                      Tone="accent"
                      Trend="@FormatPercentTrend(_kpis.OnTimeRate, _previousKpis?.OnTimeRate, higherIsBetter: true)" />
        <KpiScorecard Label="Avg. Cycle"
                      Value="@KpiAnalytics.FormatDays(_kpis.AverageCycleDays)"
                      Hint="completion days"
                      Tone="neutral"
                      Trend="@FormatDaysTrend(_kpis.AverageCycleDays, _previousKpis?.AverageCycleDays)" />
        <KpiScorecard Label="In Progress"
                      Value="@_kpis.InProgressCount.ToString()"
                      Hint="active in period"
                      Tone="warning"
                      Trend="@FormatCountTrend(_kpis.InProgressCount, _previousKpis?.InProgressCount, higherIsBetter: false)" />
        <KpiScorecard Label="Active Devs"
                      Value="@_kpis.ActiveDevelopers.ToString()"
                      Hint="@($"{_kpis.WorkspaceCount} workspace(s)")"
                      Tone="primary" />
    </div>

    @if (_kpis.Developers.Count > 0)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="data-card card h-100">
                    <div class="card-body p-0">
                        <h5 class="card-title card-title-bar">Top Contributors</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 analytics-table">
                                <thead>
                                    <tr>
                                        <th>Developer</th>
                                        <th>Done</th>
                                        <th>Completion</th>
                                        <th>Delivery</th>
                                        <th>Cycle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var summary in _kpis.Developers.Take(6))
                                    {
                                        var band = KpiAnalytics.PerformanceBand(summary.OnTimeRate, summary.CompletionRate);
                                        <tr>
                                            <td>
                                                <strong>@summary.DeveloperName</strong>
                                                <div class="small"><span class="perf-pill @KpiAnalytics.PerformanceTone(band)">@band</span></div>
                                            </td>
                                            <td><span class="badge text-bg-success">@summary.CompletedCount</span></td>
                                            <td>@KpiAnalytics.FormatPercent(summary.CompletionRate)</td>
                                            <td>@KpiAnalytics.FormatPercent(summary.OnTimeRate)</td>
                                            <td>@KpiAnalytics.FormatDays(summary.AverageCycleDays)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="chart-panel card h-100">
                    <div class="card-body">
                        <div class="chart-panel-header">
                            <div>
                                <h2 class="chart-title">Workspace Load</h2>
                                <p class="chart-subtitle">Where work is concentrated this month</p>
                            </div>
                        </div>
                        @if (_kpis.ByWorkspace.Count == 0)
                        {
                            <p class="text-muted mb-0">No workspace data.</p>
                        }
                        else
                        {
                            var maxWs = _kpis.ByWorkspace.Max(w => w.Count);
                            <div class="rank-list">
                                @foreach (var workspace in _kpis.ByWorkspace.Take(6))
                                {
                                    var width = maxWs > 0 ? workspace.Count * 100.0 / maxWs : 0;
                                    <div class="rank-row">
                                        <div class="rank-row-top">
                                            <span class="rank-name">@workspace.Name</span>
                                            <span class="rank-value">@workspace.Count</span>
                                        </div>
                                        <div class="rank-bar-track">
                                            <div class="rank-bar-fill" style="width: @width.ToString("0.##")%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="empty-state mb-4">
        <div class="empty-state-icon" aria-hidden="true">◇</div>
        <h5>Connect ClickUp to unlock analytics</h5>
        <p class="text-muted mb-3">Add accounts and sync developers to populate the MIS KPI dashboard.</p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a class="btn btn-primary" href="clickup-accounts">Add Accounts</a>
            <a class="btn btn-outline-primary" href="developers">Sync Developers</a>
        </div>
    </div>
}

<div class="feature-grid">
    <div class="feature-card card h-100">
        <div class="card-body">
            <div class="feature-icon feature-icon-indigo" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2z"/></svg>
            </div>
            <h5>MIS Analytics</h5>
            <p class="text-muted">KPI scorecards, throughput charts, delivery health, and developer leaderboards.</p>
            <a href="analytics" class="stretched-link" aria-label="Go to Analytics"></a>
        </div>
    </div>
    <div class="feature-card card h-100">
        <div class="card-body">
            <div class="feature-icon feature-icon-cyan" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/></svg>
            </div>
            <h5>Stakeholder Reports</h5>
            <p class="text-muted">Filter by period and export Excel packs for management reviews.</p>
            <a href="reports" class="stretched-link" aria-label="Go to Reports"></a>
        </div>
    </div>
    <div class="feature-card card h-100">
        <div class="card-body">
            <div class="feature-icon feature-icon-emerald" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>
            </div>
            <h5>Developer Registry</h5>
            <p class="text-muted">Map people across multiple ClickUp workspaces for unified scoring.</p>
            <a href="developers" class="stretched-link" aria-label="Go to Developers"></a>
        </div>
    </div>
</div>

@code {
    private TeamKpis? _kpis;
    private TeamKpis? _previousKpis;
    private string? _comparisonPeriodLabel;
    private IReadOnlyList<SlaCheckResult> _slaChecks = [];
    private bool _isLoadingReport = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var developers = await DeveloperApi.GetDevelopersAsync();
            var developerIds = developers.Select(d => d.Id).ToList();

            if (developerIds.Count == 0)
            {
                return;
            }

            var fromDate = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toDate = DateOnly.FromDateTime(DateTime.Today);
            var (prevFrom, prevTo) = KpiAnalytics.GetPreviousPeriod(fromDate, toDate);
            _comparisonPeriodLabel = KpiAnalytics.FormatPeriod(prevFrom, prevTo);

            var currentRequest = new DeveloperReportRequest(developerIds, fromDate, toDate, IncludeClosed: true);
            var previousRequest = new DeveloperReportRequest(developerIds, prevFrom, prevTo, IncludeClosed: true);

            var currentTask = ReportApi.GenerateDeveloperReportAsync(currentRequest);
            var previousTask = ReportApi.GenerateDeveloperReportAsync(previousRequest);
            await Task.WhenAll(currentTask, previousTask);

            var report = await currentTask;
            var previousReport = await previousTask;

            if (report is not null)
            {
                _kpis = KpiAnalytics.FromReport(report);
                _previousKpis = previousReport is not null ? KpiAnalytics.FromReport(previousReport) : null;
                _slaChecks = KpiAnalytics.EvaluateTeamSla(_kpis);
            }
        }
        catch
        {
            _kpis = null;
            _previousKpis = null;
            _slaChecks = [];
        }
        finally
        {
            _isLoadingReport = false;
        }
    }

    private KpiTrendDisplay? FormatCountTrend(int current, int? previous, bool higherIsBetter)
    {
        if (_previousKpis is null || !previous.HasValue)
        {
            return null;
        }

        return KpiAnalytics.FormatTrend(
            KpiAnalytics.TrendCount(current, previous.Value, higherIsBetter));
    }

    private KpiTrendDisplay? FormatPercentTrend(double? current, double? previous, bool higherIsBetter)
    {
        if (_previousKpis is null)
        {
            return null;
        }

        return KpiAnalytics.FormatTrend(
            KpiAnalytics.TrendPercent(current, previous, higherIsBetter));
    }

    private KpiTrendDisplay? FormatDaysTrend(double? current, double? previous)
    {
        if (_previousKpis is null)
        {
            return null;
        }

        return KpiAnalytics.FormatTrend(
            KpiAnalytics.TrendDays(current, previous),
            countLabel: "days");
    }
}
