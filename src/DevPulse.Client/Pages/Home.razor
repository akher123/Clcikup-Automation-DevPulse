@page "/"

<PageTitle>DevPulse</PageTitle>

<div class="hero">
    <h1>DevPulse</h1>
    <p class="lead">
        Developer performance and reporting platform integrating ClickUp task data
        with Cursor analytics for unified monthly KPI dashboards.
    </p>
    <a class="btn btn-primary btn-lg" href="clickup-accounts">Manage ClickUp Accounts</a>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="feature-card card h-100">
            <div class="card-body">
                <h5>Multi-Workspace ClickUp</h5>
                <p class="text-muted">Connect multiple ClickUp API tokens and aggregate tasks across all client workspaces.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card card h-100">
            <div class="card-body">
                <h5>Developer-Centric Reports</h5>
                <p class="text-muted">Filter by developers and month to produce unified task and productivity reports.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card card h-100">
            <div class="card-body">
                <h5>Cursor Integration Ready</h5>
                <p class="text-muted">Architecture is prepared for Cursor Admin and Analytics API integration in the next phase.</p>
            </div>
        </div>
    </div>
</div>
