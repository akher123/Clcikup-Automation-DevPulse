@using DevPulse.Shared.Constants
@using DevPulse.Client.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="nav-menu @(IsCollapsed ? "collapsed" : null)">
    <div class="nav-brand">
        <a class="brand-link" href="" title="@AppBranding.CompanyName">
            <span class="brand-logo-wrap">
                <img class="brand-logo" src="images/datavanced-logo.svg" alt="@AppBranding.CompanyName" />
            </span>
            @if (!IsCollapsed)
            {
                <span class="brand-sub">@AppBranding.NavSubtitle</span>
            }
        </a>
    </div>

    <div class="nav-scrollable">
        <nav class="nav flex-column">
            <AuthorizeView Roles="@AppRoles.Admin">
                <Authorized>
                    @if (!IsCollapsed)
                    {
                        <div class="nav-section-label">Main</div>
                    }

                    <div class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Dashboard" @onclick="HandleNavigate">
                            <span class="nav-icon bi-house" aria-hidden="true"></span>
                            <span class="nav-label">Dashboard</span>
                        </NavLink>
                    </div>

                    @if (!IsCollapsed)
                    {
                        <div class="nav-section-label">Management</div>
                    }

                    <div class="nav-item">
                        <NavLink class="nav-link" href="clickup-accounts" title="ClickUp Accounts" @onclick="HandleNavigate">
                            <span class="nav-icon bi-plug" aria-hidden="true"></span>
                            <span class="nav-label">ClickUp Accounts</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="developers" title="Developers" @onclick="HandleNavigate">
                            <span class="nav-icon bi-people" aria-hidden="true"></span>
                            <span class="nav-label">Developers</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="users" title="Users" @onclick="HandleNavigate">
                            <span class="nav-icon bi-shield" aria-hidden="true"></span>
                            <span class="nav-label">Users</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            @if (!IsCollapsed)
            {
                <div class="nav-section-label">Analytics</div>
            }

            <div class="nav-item">
                <NavLink class="nav-link" href="analytics" title="MIS Analytics" @onclick="HandleNavigate">
                    <span class="nav-icon bi-analytics" aria-hidden="true"></span>
                    <span class="nav-label">Analytics</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="reports" title="Reports" @onclick="HandleNavigate">
                    <span class="nav-icon bi-chart" aria-hidden="true"></span>
                    <span class="nav-label">Reports</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="holidays" title="Holiday Calendar" @onclick="HandleNavigate">
                    <span class="nav-icon bi-calendar" aria-hidden="true"></span>
                    <span class="nav-label">Holiday Calendar</span>
                </NavLink>
            </div>
        </nav>

        <div class="nav-footer">
            <AuthorizeView>
                <Authorized>
                    @if (!IsCollapsed)
                    {
                        <div class="nav-user-info">
                            <div class="nav-user-name">@context.User.Identity?.Name</div>
                            <div class="nav-user-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                        <NavLink class="btn btn-sm btn-outline-light w-100 mt-2" href="change-password" title="Change Password" @onclick="HandleNavigate">
                            Change Password
                        </NavLink>
                        <BusyButton CssClass="btn btn-sm btn-outline-light w-100 mt-2"
                                    IsBusy="_isLoggingOut"
                                    BusyText="Signing out..."
                                    OnClick="LogoutAsync">
                            Sign Out
                        </BusyButton>
                    }
                    else
                    {
                        <NavLink class="nav-logout-icon" href="change-password" title="Change Password" aria-label="Change Password" @onclick="HandleNavigate">
                            <span class="nav-icon bi-key" aria-hidden="true"></span>
                        </NavLink>
                        <button type="button"
                                class="nav-logout-icon"
                                title="Sign Out"
                                aria-label="Sign Out"
                                disabled="@_isLoggingOut"
                                @onclick="LogoutAsync">
                            <span class="nav-icon bi-logout" aria-hidden="true"></span>
                        </button>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _isLoggingOut;

    private async Task HandleNavigate()
    {
        await OnNavigate.InvokeAsync();
    }

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;

        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("login", replace: true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }
}
