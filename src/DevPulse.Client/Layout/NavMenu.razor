@using DevPulse.Shared.Constants
@using DevPulse.Client.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="nav-brand">
    <a class="brand-link" href="">
        <span class="brand-logo-wrap">
            <img class="brand-logo" src="images/datavanced-logo.svg" alt="@AppBranding.CompanyName" />
        </span>
        <span class="brand-sub">@AppBranding.NavSubtitle</span>
    </a>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <AuthorizeView Roles="@AppRoles.Admin">
            <Authorized>
                <div class="nav-section-label">Main</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="HandleNavigate">
                        <span class="nav-icon bi-house" aria-hidden="true"></span>
                        <span>Dashboard</span>
                    </NavLink>
                </div>

                <div class="nav-section-label">Management</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="clickup-accounts" @onclick="HandleNavigate">
                        <span class="nav-icon bi-plug" aria-hidden="true"></span>
                        <span>ClickUp Accounts</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="developers" @onclick="HandleNavigate">
                        <span class="nav-icon bi-people" aria-hidden="true"></span>
                        <span>Developers</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="users" @onclick="HandleNavigate">
                        <span class="nav-icon bi-shield" aria-hidden="true"></span>
                        <span>Users</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-section-label">Analytics</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="reports" @onclick="HandleNavigate">
                <span class="nav-icon bi-chart" aria-hidden="true"></span>
                <span>Reports</span>
            </NavLink>
        </div>
    </nav>

    <div class="nav-footer">
        <AuthorizeView>
            <Authorized>
                <div class="nav-user-info">
                    <div class="nav-user-name">@context.User.Identity?.Name</div>
                    <div class="nav-user-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
                <BusyButton CssClass="btn btn-sm btn-outline-light w-100 mt-2"
                            IsBusy="_isLoggingOut"
                            BusyText="Signing out..."
                            OnClick="LogoutAsync">
                    Sign Out
                </BusyButton>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _isLoggingOut;

    private async Task HandleNavigate()
    {
        await OnNavigate.InvokeAsync();
    }

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;

        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("login", replace: true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }
}
